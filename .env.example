DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
ACCESS_PASSWORD=your_shared_access_password_here
PORT=5174

# PPT-master: native flags remain opt-in. Linux production requires isolation checks.
PPT_PROJECTS_ENABLED=false
# temporary uses a fresh private directory per server start; no retention guarantee.
PPT_STORAGE_MODE=persistent
# Enable only with the cloud Docker image and after cloud acceptance.
PPT_CLOUD_EXECUTION_ENABLED=false
PPT_NATIVE_PLANNING_ENABLED=false
PPT_NATIVE_AUTHORING_ENABLED=false
PPT_NATIVE_POSTPROCESS_ENABLED=false
PPT_NATIVE_VISUAL_REVIEW_ENABLED=false
# PPT_BROWSER_ROOT=/absolute/path/to/.ppt-runtime/browsers
# PPT_DATA_ROOT=/absolute/path/to/persistent-ppt-projects
# PPT_MASTER_SKILL_ROOT=/absolute/path/to/.ppt-runtime/ppt-master/skills/ppt-master
# PPT_PYTHON=/absolute/path/to/.ppt-runtime/venv/bin/python
